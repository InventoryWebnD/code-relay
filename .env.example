# NextAuth / Auth.js Configuration
# Generate a secure secret using: openssl rand -base64 32
AUTH_SECRET="your-generated-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage Configuration (for submission file uploads & slides)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="competition-submissions"

# Optional: Google OAuth Provider Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
