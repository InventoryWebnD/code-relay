# NextAuth / Auth.js Configuration
# Generate a secure secret using: openssl rand -base64 32
AUTH_SECRET="your-generated-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage Configuration (for submission file uploads & slides)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="competition-submissions"

# Optional: Google OAuth Provider Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Registration happens on Unstop: paste the Code Relay 5.0 Unstop page here when it goes live.
# Until it is set, every Register button shows "Registrations open soon" and /register redirects home.
NEXT_PUBLIC_REGISTER_URL="https://unstop.com/p/code-relay-50-indian-institute-of-technology-iit-bhubaneswar-1810370"

# Public site origin used for canonical URLs, sitemap, robots and share cards (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://code-relay.vercel.app"
# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
